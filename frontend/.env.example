# ── InsightPulse frontend configuration ─────────────────────────────
#
# Copy to `.env` for local overrides, or set these in the Vercel dashboard
# (Project → Settings → Environment Variables).
#
# Nothing here is a secret. This is a public backend URL — no API keys are ever
# placed in frontend code. All provider credentials live in the backend's own
# environment.

# Backend origin the built app talks to.
#
# Leave EMPTY for local development: `npm run dev` proxies /api and /health to
# the local FastAPI server (see vite.config.js), so same-origin just works.
#
# REQUIRED for the Vercel deployment, because the frontend and backend are on
# different origins there.
VITE_API_BASE=https://insightpulse-ai-agent.onrender.com

# Optional: point `npm run dev` at a different local backend.
# VITE_DEV_BACKEND=http://127.0.0.1:8000
