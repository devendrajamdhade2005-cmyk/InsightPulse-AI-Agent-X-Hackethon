# ?? InsightPulse frontend configuration ?????????????????????????????
#
# Copy to `.env` for local overrides, or set these in the Vercel dashboard
# (Project -> Settings -> Environment Variables).
#
# Nothing here is a secret. Only VITE_*-prefixed variables reach the browser, and
# anything that reaches the browser is public by definition ? which is exactly why
# no provider API key belongs here. They stay on the backend.

# Backend origin the built app talks to.
#
# LOCAL DEV: leave this EMPTY. `npm run dev` proxies /api and /health to the local
# FastAPI server (see vite.config.js), so same-origin works with no CORS setup.
#
# PRODUCTION (Vercel): required, because the frontend and backend are on different
# origins.
#
# This project's value ? paste exactly this into Vercel:
#
#   VITE_API_BASE=https://insightpulse-ai-production.up.railway.app
#
#   MUST be Railway's PUBLIC domain:   https://<service>.up.railway.app
#   MUST NOT be the private hostname:  https://insightpulse-ai.railway.internal
#
# `*.railway.internal` only resolves inside your Railway project. A browser cannot
# reach it, so using it here gives ERR_NAME_NOT_RESOLVED on every request.
#
# No trailing slash. Vite inlines VITE_* at BUILD time, so changing this requires a
# redeploy, not just a restart.
#
# Left empty here on purpose: if you copy this file to `.env`, local dev should keep
# using the proxy rather than silently hitting production.
VITE_API_BASE=

# Optional: point `npm run dev` at a different local backend.
# VITE_DEV_BACKEND=http://127.0.0.1:8000
