# ─────────────────────────────────────────────────────────────
# InsightPulse AI — configuration
#
# Copy to `.env`. EVERY VALUE IS OPTIONAL.
#
# With zero keys the agent still runs end to end: providers without a key serve
# clearly-labelled synthetic data, and planning/tool-selection/prioritization fall
# back to a deterministic reasoner. The UI and reports always state which parts
# were live and which were simulated.
# ─────────────────────────────────────────────────────────────

# ── core ────────────────────────────────────────────────────
APP_ENV=development

# Every origin that may call this API. The React dev server runs on 5173, and
# your Vercel domain must be added for production or the browser blocks the
# cross-origin requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Signs the session JWTs. MUST be a long random string in production —
# generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

# Where accounts, profiles and scan history live when Firestore is off.
DATABASE_URL=sqlite:///./data/insightpulse.db

# Session lifetime in minutes (default 7 days).
ACCESS_TOKEN_TTL_MINUTES=10080

# Leave blank for local use. Set it before exposing this service on a network:
# POST /api/agent/run spends API quota and makes outbound requests on demand.
# Clients then send it as the `X-API-Token` header.
AGENT_API_TOKEN=


# ═════════════════════════════════════════════════════════════
# IDENTITY & PERSISTENCE (Firebase)
# ═════════════════════════════════════════════════════════════
# All optional. With Firebase off, accounts work against SQLite with locally
# hashed passwords, and /health reports that plainly.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=

# Admin credentials — pick ONE of these two.
#   A) local development: path to the service-account JSON (gitignored)
FIREBASE_CREDENTIALS_FILE=
#   B) hosted (Railway/Vercel): paste the WHOLE JSON on one line.
#      This is the right option on a platform where you cannot upload a file.
FIREBASE_CREDENTIALS_JSON=

# Use Firestore for accounts/profiles/history instead of SQLite. Requires the
# Admin credentials above. If Firestore cannot be reached the app falls back to
# SQLite and says so in /health rather than failing silently.
FIRESTORE_ENABLED=false

# REQUIRED for Firebase email/password sign-in. The Admin SDK can create a user
# but has NO password-verification API — that lives in the Identity Toolkit REST
# API, which is keyed by this value. Without it, passwords are verified against a
# local bcrypt hash instead.
# Firebase console -> Project settings -> General -> "Web API Key".
FIREBASE_WEB_API_KEY=

# Auth policy
PASSWORD_MIN_LENGTH=8
ALLOW_REGISTRATION=true
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
HISTORY_RETENTION_PER_USER=100


# ═════════════════════════════════════════════════════════════
# REASONING ENGINE
# ═════════════════════════════════════════════════════════════
# auto  → Gemini if GEMINI_API_KEY is set, else Anthropic, else heuristic
# gemini | anthropic | none
LLM_PROVIDER=auto

# Google AI Studio — free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Benchmarked: gemini-3.5-flash answers in ~1.1s with thinking disabled.
# The client verifies the model on boot and fails over if it is unavailable.
GEMINI_MODEL=gemini-3.5-flash

# Optional Claude path. Requires `pip install anthropic`.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Cost ceiling per run. On breach the agent finishes on the heuristic reasoner.
LLM_RUN_BUDGET_USD=0.50
LLM_DAILY_BUDGET_USD=5.00


# ═════════════════════════════════════════════════════════════
# AGENT BEHAVIOUR
# ═════════════════════════════════════════════════════════════
# true = never touch the network; all providers return synthetic labelled data.
SIMULATION_MODE=false
# Hard cap on the reason→act→observe loop.
MAX_RESULTS_PER_SOURCE=12
COLLECT_TIMEOUT_SECONDS=25


# ═════════════════════════════════════════════════════════════
# DATA SOURCES
# ═════════════════════════════════════════════════════════════
# ── Live with NO key (nothing to configure) ─────────────────
#   arXiv          https://export.arxiv.org/api/query
#   OpenAlex       https://api.openalex.org/works
#   Curated RSS    publisher feeds (IEEE Spectrum, Nature, TechCrunch, …)
#   Hacker News    https://hn.algolia.com/api/v1/search_by_date
#   GitHub         https://api.github.com/search/repositories

# ── Live web search (competitor / announcement intelligence) ─
# Free dev key: https://app.tavily.com
TAVILY_API_KEY=

# ── Patents — free key, makes the Patent section real USPTO data
# Request at: https://patentsview.org/apis/keyrequest
PATENTSVIEW_API_KEY=
# Alternative patent route via Google Patents (paid; free trial only)
SERPAPI_KEY=

# ── Research — free key, adds citation counts, venues, institutions
# Request at: https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# ── News — free developer tiers
# https://newsapi.org/register
NEWSAPI_KEY=
# https://newsdata.io/register — keys look like "pub_xxxxxxxx".
# Free tier: 10 articles per request, no date filter, no full article body.
NEWSDATA_API_KEY=
# https://gnews.io — keys are bare hex, NOT the "pub_" form (that is newsdata.io)
GNEWS_API_KEY=

# ── Raises rate limits on already-live sources ──────────────
# Classic token, no scopes needed: https://github.com/settings/tokens
GITHUB_TOKEN=
# Create a "script" app: https://www.reddit.com/prefs/apps
# Without OAuth, Reddit 403s most server IPs.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:insightpulse.agent:2.0 (research intelligence agent)

# ── Tracing & observability (Task 7) ────────────────────────
# All optional. Tracing is on by default and entirely local — nothing leaves the
# machine unless you explicitly enable export below.
# Master switch. Set to false to run completely untraced.
OBSERVABILITY_ENABLED=true
# Optional mirror of spans to an external collector (OTLP-shaped HTTP POST).
# The local trace is always kept and recorded first, so an export failure can
# never lose a trace or affect a run.
TRACE_EXPORT_ENABLED=false
# e.g. an OpenTelemetry collector, or a Langfuse / LangSmith OTLP gateway
TRACE_EXPORT_ENDPOINT=
# Sent as a bearer token. Never written into a trace or returned by /status.
TRACE_EXPORT_API_KEY=
# Project label attached to exported traces
TRACE_PROJECT=insightpulse
